<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Choose a persona to sign in. hamnir is a local OpenID Connect provider for development and testing.">
<title>hamnir — choose a persona</title>
<style>{{ .CSS }}</style>
</head>
<body>
<div class="app">
  <header class="site-header">
    <div class="wrap header-inner">
      <div class="brand">
        <div class="brand-name">hamnir</div>
        <div class="brand-tagline">dev-only OpenID Connect provider</div>
      </div>
    </div>
  </header>

  <main class="wrap">
    {{ range .Groups }}
    <section class="group" style="--accent: {{ .Colour }}">
      <h2 class="group-label"><span class="dot" style="background: {{ .Colour }}"></span>{{ .Label }}</h2>
      <div class="grid">
      {{ range .Personas }}
        <form method="post" action="/login/select">
          <input type="hidden" name="authRequestID" value="{{ $.AuthRequestID }}">
          <input type="hidden" name="sub" value="{{ .Sub }}">
          <button class="card">
            {{ if .Picture }}<img class="avatar" src="{{ .Picture }}" alt="">{{ else }}<span class="avatar-placeholder" aria-hidden="true">{{ .Initial }}</span>{{ end }}
            <span class="card-text">
              <span class="name">{{ .Name }}</span>
              {{ if .Description }}<span class="desc">{{ .Description }}</span>{{ end }}
            </span>
          </button>
        </form>
      {{ end }}
      </div>
    </section>
    {{ end }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p class="caption">Personas are defined in your <code>hamnir.yaml</code>.</p>
    </div>
  </footer>
</div>
</body>
</html>
