<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>hamnir — choose a persona</title>
<link rel="stylesheet" href="/static/style.css"></head>
<body>
<main>
<h1>Who would you like to continue as?</h1>
{{ range .Groups }}
<section class="group">
  <h2 style="border-color: {{ .Colour }}">{{ .Label }}</h2>
  <div class="grid">
  {{ range .Personas }}
    <form method="post" action="/login/select">
      <input type="hidden" name="authRequestID" value="{{ $.AuthRequestID }}">
      <input type="hidden" name="sub" value="{{ .Sub }}">
      <button class="card" style="--accent: {{ .Colour }}">
        <span class="name">{{ .Name }}</span>
        {{ if .Description }}<span class="desc">{{ .Description }}</span>{{ end }}
      </button>
    </form>
  {{ end }}
  </div>
</section>
{{ end }}
</main>
</body></html>
