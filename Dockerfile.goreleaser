FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

ARG TARGETPLATFORM

WORKDIR /home/nonroot

# goreleaser lays out the build context with per-platform subdirs
# (linux/amd64/, linux/arm64/), selected here via $TARGETPLATFORM.
COPY $TARGETPLATFORM/hamnir /usr/local/bin/hamnir

ENV HAMNIR_ADDR=0.0.0.0:5556

EXPOSE 5556

ENTRYPOINT ["hamnir"]

CMD ["serve"]
